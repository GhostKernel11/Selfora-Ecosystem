PORT=3000
DB_PATH=./data/academic.sqlite
# REQUIRED in production: use a long random secret (at least 32 bytes).
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
# Optional backup destination.
BACKUP_DIR=./backups
# Required to enable the protected operator status endpoint.
OPS_TOKEN=replace-with-a-long-random-operator-token
# Optional URL for post-deployment launch checks.
BASE_URL=http://127.0.0.1:3000
